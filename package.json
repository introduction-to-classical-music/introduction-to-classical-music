{
  "name": "buquanshu",
  "version": "0.1.2",
  "description": "Windows-first desktop edition for building, maintaining, and browsing local classical music libraries.",
  "author": {
    "name": "Introduction to Classical Music Contributors"
  },
  "private": false,
  "build": {
    "executableName": "不全书",
    "appId": "com.classical.guide.desktop.note",
    "productName": "不全书",
    "directories": {
      "output": "output/releases"
    },
    "files": [
      "package.json",
      "apps/desktop/**/*",
      "apps/owner/web/**/*",
      "apps/site/**/*",
      "packages/**/*",
      "data/**/*",
      "materials/**/*",
      "output/runtime/**/*",
      "output/site/**/*",
      "node_modules/astro/templates/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/tests/**",
      "!**/test/**",
      "!**/docs/**",
      "!**/coverage/**",
      "!**/.cache/**",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/__snapshots__/**",
      "!**/node_modules/**/*.ts"
    ],
    "extraResources": [
      {
        "from": "tools/recording-retrieval-service/app/dist/portable",
        "to": "recording-retrieval-service",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "afterPack": "scripts/electron-after-pack.mjs",
    "win": {
      "icon": "apps/desktop/assets/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "buquanshu-setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "scripts/windows/installer-compat.nsh",
      "installerIcon": "apps/desktop/assets/app-icon.ico",
      "uninstallerIcon": "apps/desktop/assets/app-icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "apps/**/*",
      "packages/**/*",
      "data/**/*",
      "materials/**/*",
      "output/runtime/apps/owner/**/*",
      "output/runtime/packages/**/*",
      "output/runtime/scripts/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/tests/**",
      "!**/test/**",
      "!**/docs/**",
      "!**/coverage/**",
      "!**/.cache/**",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/__snapshots__/**",
      "!**/node_modules/**/*.ts"
    ]
  },
  "main": "output/runtime/apps/desktop/main.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "audit:text": "node scripts/audit-text-encoding.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:gate-self-test": "node scripts/self-test-audit-gates.mjs",
    "assets:prepare": "node scripts/prepare-shared-assets.mjs",
    "bootstrap:windows": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-windows.ps1",
    "doctor:windows": "powershell -ExecutionPolicy Bypass -File scripts/doctor-windows.ps1",
    "dev": "npm run assets:prepare && npm run build:indexes && astro dev --root apps/site --host 127.0.0.1 --port 4321",
    "build": "npm run assets:prepare && npm run runtime:build && node output/runtime/scripts/build-library-site.js",
    "build:library": "npm run assets:prepare && npm run runtime:build && node output/runtime/scripts/build-library-site.js",
    "library:audit": "node scripts/audit-library-bundle.mjs",
    "library:sync": "node scripts/sync-library-source.mjs",
    "site:export": "npm run runtime:build && node scripts/export-site-release.mjs",
    "default-library:export": "npm run build && node scripts/export-default-library.mjs",
    "public:audit": "node scripts/audit-public-boundary.mjs",
    "preview": "astro preview --root apps/site",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:indexes": "npm run runtime:build && node output/runtime/scripts/build-indexes.js",
    "entity-vitals:audit": "npm run runtime:build && node scripts/audit-entity-vitals.mjs",
    "entity-vitals:sync": "npm run runtime:build && node scripts/sync-entity-vitals-review.mjs && node scripts/apply-entity-vitals-review.mjs",
    "import:legacy": "npm run runtime:build && node output/runtime/scripts/import-legacy.js",
    "recording:legacy-audit": "npm run runtime:build && node output/runtime/scripts/audit-recording-legacy-alignment.js",
    "recording:live-audit": "npm run runtime:build && node scripts/audit-recording-retrieval-live.mjs",
    "recording:live-verify": "npm run runtime:build && node scripts/verify-recording-retrieval-live-integration.mjs",
    "reference:audit": "npm run runtime:build && node output/runtime/scripts/audit-reference-registry.js",
    "reference:query": "npm run runtime:build && node output/runtime/scripts/query-reference-registry.js",
    "reference:sync": "npm run runtime:build && node output/runtime/scripts/sync-reference-registry.js",
    "retrieval:portable:build": "powershell -ExecutionPolicy Bypass -File tools/recording-retrieval-service/app/packaging/build-portable.ps1",
    "owner": "npm run assets:prepare && npm run runtime:build && node output/runtime/apps/owner/server/owner-app.js",
    "desktop:dev": "npm run assets:prepare && npm run runtime:build && electron .",
    "desktop:dist": "node scripts/clean-desktop-release.mjs && npm run build && npm run retrieval:portable:build && electron-builder --win nsis --publish never && node scripts/patch-release-icons.mjs",
    "desktop:dist:signed": "node scripts/clean-desktop-release.mjs && npm run build && npm run retrieval:portable:build && electron-builder --win nsis --publish never --config.win.signAndEditExecutable=true && node scripts/patch-release-icons.mjs",
    "desktop:dist:release": "node scripts/clean-desktop-release.mjs && npm run build && npm run retrieval:portable:build && electron-builder --win nsis --publish always --config.win.signAndEditExecutable=true && node scripts/patch-release-icons.mjs",
    "desktop:portable:build": "node scripts/clean-portable-release.mjs && npm run build && node scripts/build-portable-release.mjs",
    "package:windows": "npm run doctor:windows && npm run desktop:dist && npm run audit:release && npm run release:checksums",
    "astro:check": "node --max-old-space-size=8192 node_modules/astro/bin/astro.mjs check --root apps/site",
    "check": "npm run assets:prepare && npm run audit:text && npm run audit:secrets && npm run entity-vitals:audit && npm run reference:audit && npm run audit:gate-self-test && npm run astro:check && vitest run",
    "check:long-paths": "node scripts/check-long-paths.mjs",
    "check:long-paths:workspace": "node scripts/check-long-paths.mjs --repo . --repo ../../library/Salon_library --repo ../../site-deploy/introduction-to-classical-music-site-deploy --repo tools/recording-retrieval-service/app --warn-only --max-report 15",
    "runtime:build": "tsc -p tsconfig.runtime.json",
    "generate:exceptions": "node scripts/generate-dependency-exceptions.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "audit:release": "node scripts/audit-release-artifact.mjs",
    "release:checksums": "node scripts/write-release-checksums.mjs",
    "verify:signing": "powershell -ExecutionPolicy Bypass -File scripts/verify-release-signing.ps1"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "adm-zip": "^0.6.1",
    "astro": "6.4.8",
    "cheerio": "^1.2.0",
    "express": "5.3.0",
    "iconv-lite": "^0.7.2",
    "markdown-it": "15.0.3",
    "sanitize-html": "2.18.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "devalue": "5.9.4",
    "esbuild": "0.28.2",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "tinyglobby": "0.2.17",
    "undici": "8.12.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/introduction-to-classical-music/introduction-to-classical-music.git"
  },
  "homepage": "https://github.com/introduction-to-classical-music/introduction-to-classical-music",
  "bugs": {
    "url": "https://github.com/introduction-to-classical-music/introduction-to-classical-music/issues"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.12.2",
    "electron": "^41.2.1",
    "electron-builder": "^26.0.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
